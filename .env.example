# Copie este arquivo para ".env" e preencha os valores.
# O ".env" está no .gitignore e NUNCA deve ser commitado.
# Em produção, as mesmas variáveis vão no env_variables do app.yaml.

# --- Django ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Separadas por vírgula, com o esquema. Ex.: https://meusite.appspot.com
CSRF_TRUSTED_ORIGINS=

# --- Banco (vazio = SQLite local) ---
DATABASE_URL=

# --- IA (Google Gemini) — crie a chave em https://aistudio.google.com/apikey ---
GEMINI_API_KEY=

# --- Bot do Telegram (crie o bot com o @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Texto aleatório (1 a 256 caracteres: A-Z, a-z, 0-9, _ e -) enviado pelo
# Telegram no cabeçalho X-Telegram-Bot-Api-Secret-Token de cada webhook.
TELEGRAM_WEBHOOK_SECRET=
# Nome do bot sem o @ (usado no link t.me/<nome>?start=<código>)
TELEGRAM_BOT_USERNAME=

# --- Opcionais ---
# HSTS em produção, em segundos (padrão 3600)
# SECURE_HSTS_SECONDS=
# Gemini pela identidade do App Engine (Vertex AI), sem API Key
# GEMINI_USAR_VERTEX=False
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
